    "def gauss_jordan(A, b):\n",
    "    \"\"\"\n",
    "    Resuelve el sistema Ax = b usando eliminación de Gauss-Jordan\n",
    "    \"\"\"\n",
    "    n = len(b)\n",
    "    # Crear matriz aumentada [A|b]\n",
    "    Ab = np.concatenate([A.copy(), b.reshape(-1, 1)], axis=1).astype(float)\n",
    "    \n",
    "    # Eliminación\n",
    "    for i in range(n):\n",
    "        # Pivoteo parcial\n",
    "        max_row = i + np.argmax(np.abs(Ab[i:, i]))\n",
    "        Ab[[i, max_row]] = Ab[[max_row, i]]\n",
    "        \n",
    "        # Normalizar fila pivote\n",
    "        pivot = Ab[i, i]\n",
    "        if abs(pivot) < 1e-10:\n",
    "            raise ValueError(\"Sistema singular\")\n",
    "        Ab[i] = Ab[i] / pivot\n",
    "        \n",
    "        # Eliminar columna en otras filas\n",
    "        for j in range(n):\n",
    "            if i != j:\n",
    "                factor = Ab[j, i]\n",
    "                Ab[j] = Ab[j] - factor * Ab[i]\n",
    "    \n",
    "    return Ab[:, -1]\n",
    "\n",
    "# Ejemplo de uso\n",
    "print(\"Ejemplo: Sistema 2x2\")\n",
    "A_test = np.array([[2, 1], [1, 3]], dtype=float)\n",
    "b_test = np.array([5, 7], dtype=float)\n",
    "\n",
    "print(f\"A = \\n{A_test}\")\n",
    "print(f\"b = {b_test}\")\n",
    "\n",
    "x = gauss_jordan(A_test, b_test)\n",
    "print(f\"\\nSolución x = {x}\")\n",
    "print(f\"Verificación Ax = {A_test @ x}\")"
   ]
