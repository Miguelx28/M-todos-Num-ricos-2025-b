    "def spline_cubico_natural(x, y):\n",
    "    n = len(x) - 1\n",
    "\n",
    "    # Paso 1: h\n",
    "    h = [x[i+1] - x[i] for i in range(n)]\n",
    "\n",
    "    # Paso 2: alpha\n",
    "    alpha = [0]*(n+1)\n",
    "    for i in range(1, n):\n",
    "        alpha[i] = 3*((y[i+1]-y[i])/h[i] - (y[i]-y[i-1])/h[i-1])\n",
    "\n",
    "    # Paso 3: sistema tridiagonal\n",
    "    l = [1] + [0]*n\n",
    "    mu = [0]*(n+1)\n",
    "    z = [0]*(n+1)\n",
    "\n",
    "    for i in range(1, n):\n",
    "        l[i] = 2*(x[i+1]-x[i-1]) - h[i-1]*mu[i-1]\n",
    "        mu[i] = h[i]/l[i]\n",
    "        z[i] = (alpha[i]-h[i-1]*z[i-1])/l[i]\n",
    "\n",
    "    l[n] = 1\n",
    "    z[n] = 0\n",
    "\n",
    "    # Paso 4: coeficientes\n",
    "    a = y[:-1]\n",
    "    b = [0]*n\n",
    "    c = [0]*(n+1)\n",
    "    d = [0]*n\n",
    "\n",
    "    for j in range(n-1, -1, -1):\n",
    "        c[j] = z[j] - mu[j]*c[j+1]\n",
    "        b[j] = (y[j+1]-y[j])/h[j] - h[j]*(2*c[j]+c[j+1])/3\n",
    "        d[j] = (c[j+1]-c[j])/(3*h[j])\n",
    "\n",
    "    return a, b, c[:-1], d\n"
   ]
  },
