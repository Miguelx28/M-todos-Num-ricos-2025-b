    "def evaluar_spline(x_eval, x, a, b, c, d):\n",
    "      \n",
    "    for j in range(len(a)):\n",
    "            if x[j] <= x_eval <= x[j+1]:\n",
    "                dx = x_eval - x[j]\n",
    "                return a[j] + b[j]*dx + c[j]*dx**2 + d[j]*dx**3\n",
    "    return None\n",
