    "def evaluar_spline(x_eval, x, a, b, c, d):\n",
    "    \"\"\"\n",
    "    Evalúa el spline cúbico en los puntos x_eval\n",
    "    \"\"\"\n",
    "    y_eval = []\n",
    "\n",
    "    for xv in x_eval:\n",
    "        # buscar el tramo correcto\n",
    "        for j in range(len(a)):\n",
    "            if x[j] <= xv <= x[j+1]:\n",
    "                dx = xv - x[j]\n",
    "                yv = a[j] + b[j]*dx + c[j]*dx**2 + d[j]*dx**3\n",
    "                y_eval.append(yv)\n",
    "                break\n",
    "\n",
    "    return y_eval\n"
   ]
